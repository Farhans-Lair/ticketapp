# =========================================================
# Terraform (VERY IMPORTANT)
# =========================================================
**/.terraform/*
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Keep provider lock file (DO NOT IGNORE)
!.terraform.lock.hcl

# Terraform plan output files — binary snapshots that embed full state
# (including sensitive values). Always name plan output *.tfplan going
# forward: terraform plan -out=tfplan
*.tfplan

# Safety net for stray files previously found in this repo
terraform/option
terraform/options

rzp-key.csv

# =========================================================
# Environment / Secrets
# =========================================================
.env
.env.*
!.env.example

